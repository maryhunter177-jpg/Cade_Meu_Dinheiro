<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:CadeMeuDinheiro.App.ViewModels" x:Class="CadeMeuDinheiro.App.Views.DashboardPage" x:DataType="vm:DashboardViewModel" Title="Início">
  <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
    <ScrollView><VerticalStackLayout Padding="24,24,24,96" Spacing="18">
      <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Olá!" Style="{StaticResource Caption}"/><Label Text="Seu dinheiro, com clareza" Style="{StaticResource Title}"/></VerticalStackLayout><Image Source="brand_mark.png" WidthRequest="48" HeightRequest="48" SemanticProperties.Description="Marca Cadê Meu Dinheiro"/></Grid>
      <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource Navy900}" StrokeThickness="0"><Grid RowDefinitions="Auto,Auto,Auto"><Label Text="Saldo disponível" TextColor="#C9D6E2"/><Label Grid.Row="1" Text="{Binding Balance, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="34" FontAttributes="Bold" Margin="0,6,0,16"/><Label Grid.Row="2" Text="Atualizado agora" TextColor="#C9D6E2" FontSize="12"/></Grid></Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Receitas" Style="{StaticResource Caption}"/><Label Text="{Binding Income, StringFormat='R$ {0:N2}'}" TextColor="{StaticResource Emerald500}" FontAttributes="Bold" FontSize="20"/></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Despesas" Style="{StaticResource Caption}"/><Label Text="{Binding Expenses, StringFormat='R$ {0:N2}'}" TextColor="{StaticResource Red500}" FontAttributes="Bold" FontSize="20"/></VerticalStackLayout></Border></Grid>
      <Grid ColumnDefinitions="*,Auto"><Label Text="Movimentações recentes" FontSize="19" FontAttributes="Bold"/><Button Grid.Column="1" Text="Ver todas" BackgroundColor="Transparent" TextColor="{StaticResource Emerald500}" Command="{Binding OpenTransactionsCommand}"/></Grid>
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}" Spacing="10"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:TransactionItemViewModel"><Border Style="{StaticResource Card}" Padding="16"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Description}" FontAttributes="Bold"/><Label Text="{Binding DateText}" Style="{StaticResource Caption}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" VerticalOptions="Center" FontAttributes="Bold"/></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
      <Border IsVisible="{Binding HasNoTransactions}" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="Tudo começa com um registro" FontAttributes="Bold" FontSize="18"/><Label Text="Você ainda não possui transações neste mês." Style="{StaticResource Caption}"/><Button Text="+ Nova transação" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/></VerticalStackLayout></Border>
      <Button Text="Tentar novamente" IsVisible="{Binding HasError}" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" SemanticProperties.Hint="Recarrega os dados do dashboard"/>
    </VerticalStackLayout></ScrollView>
  </RefreshView>
</ContentPage>
